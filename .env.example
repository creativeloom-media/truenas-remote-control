# TrueNAS address
NAS_HOST=192.168.1.12
NAS_PORT=443

# TrueNAS API key: Top-right user menu > API Keys > Add
NAS_API_KEY=

# Leave blank if you can't use Wake-on-LAN (power on will be disabled)
# Find it in TrueNAS: Network > Interfaces, or the BIOS
NAS_MAC=

# PIN you will type on your phone (min 4 characters)
APP_PIN=change-me

# Optional
PORT=8080
TZ=Europe/London
WOL_BROADCAST=255.255.255.255
NAS_VERIFY_TLS=false
